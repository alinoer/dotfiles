# Tool yang dibutuhkan dotfiles ini.
# Install semua:   brew bundle --file=~/dotfiles/Brewfile
# Cek yang kurang: brew bundle check --file=~/dotfiles/Brewfile

tap "nikitabobko/tap"

# ─── Dasar ───────────────────────────────────────────────
brew "git"
brew "gh"
brew "stow"
brew "bash"                     # bash modern untuk ~/bin/workspace

# ─── Editor & terminal multiplexer ───────────────────────
brew "neovim"
brew "tmux"
brew "tree-sitter-cli"          # compile parser nvim-treesitter
brew "ripgrep"                  # grep di nvim
brew "fd"
brew "fzf"
brew "lazygit"

# ─── Shell (zsh) ─────────────────────────────────────────
brew "powerlevel10k"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zoxide"
brew "eza"                      # alias ls

# ─── Bahasa & database ───────────────────────────────────
brew "go"
brew "postgresql@15"
# Node via nvm dan Bun via script resmi masing-masing (lihat README)

# ─── Window manager & input ──────────────────────────
cask "nikitabobko/tap/aerospace"
cask "karabiner-elements"
cask "linearmouse"
cask "raycast"

# ─── Aplikasi & font ─────────────────────────────────────
cask "ghostty"
cask "herd"
cask "font-meslo-lg-nerd-font"  # Ghostty + Powerlevel10k
