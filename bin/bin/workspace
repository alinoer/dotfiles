#!/opt/homebrew/bin/bash

# ============================================================
# Workspace Manager - Multi-project tmux session launcher
# ============================================================

# KONFIGURASI - EDIT SESUAI KEBUTUHAN KAMU
# Format: [project_name]="$HOME/path/to/project:dir1,dir2,dir3"
# ============================================================

declare -A PROJECTS=(
    [rupay]="$HOME/code/rpy:backoffice-backend,backoffice-dashboard,merchant-backend,merchant-dashboard,core,core-cash-out,data-design,automation,frontpage,payment-page"
    [kompaspay]="$HOME/code/kompaspay:backoffice,backoffice-backend,core,merchant,merchant-backend"
    [goldenpay]="$HOME/code/gldpy:automation,backoffice,backoffice-backend,core,data-design,merchant,merchant-backend,partner-dashboard,partner-dashboard-backend,payment-page"
    [monsterpay]="$HOME/code/monsterpay:automation,backoffice,backoffice-backend,core,data-design,merchant,merchant-backend,partner-dashboard,partner-dashboard-backend,payment-page"
    [onepay]="$HOME/code/onepay:automation,backoffice,backoffice-backend,core,data-design,merchant,merchant-backend,payment-page,profit-dashboard,profit-dashboard-backend,settlement"
    [onetwopay]="$HOME/code/onetwopay:backoffice,backoffice-backend,data-design,merchant,merchant-backend"
    [globalpay]="$HOME/code/global-pay:automation,backoffice,backoffice-backend,core,data-design,merchant,merchant-backend,payment-page,profit-dashboard,profit-dashboard-backend,settlement"
    [levelup]="$HOME/code/level-up:automation,backoffice,backoffice-backend,core,data-design,merchant,merchant-backend,payment-page,profit-dashboard,profit-dashboard-backend,settlement"
)

# ============================================================
# FUNCTIONS
# ============================================================

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

show_menu() {
    echo ""
    echo -e "${BLUE}🚀 === Project Workspace Manager ===${NC}"
    echo ""
    
    # Sort project names for consistent order
    local sorted_projects=($(printf '%s\n' "${!PROJECTS[@]}" | sort))
    local counter=1
    for project_name in "${sorted_projects[@]}"; do
        echo "  $counter) $project_name"
        ((counter++))
    done
    echo "  $counter) Exit"
    echo ""
}

list_projects() {
    echo -e "${BLUE}📁 Available Projects:${NC}"
    echo ""
    
    for project_name in "${!PROJECTS[@]}"; do
        local config="${PROJECTS[$project_name]}"
        IFS=':' read -r path subdirs <<< "$config"
        echo -e "  ${GREEN}$project_name${NC}"
        echo "    Path: $path"
        echo "    Dirs: $subdirs"
        echo ""
    done
}

get_project_config() {
    local project_name=$1
    local config="${PROJECTS[$project_name]}"
    echo "$config"
}

create_tmux_session() {
    local project_name=$1
    local config=$(get_project_config "$project_name")
    
    if [[ -z "$config" ]]; then
        echo -e "${RED}❌ Project '$project_name' not found${NC}"
        return 1
    fi
    
    IFS=':' read -r proj_path subdirs <<< "$config"
    
    # Validate path exists
    if [[ ! -d "$proj_path" ]]; then
        echo -e "${RED}❌ Project path does not exist: $proj_path${NC}"
        echo "   Please update configuration in this script"
        return 1
    fi
    
    # Check if session already exists
    if tmux has-session -t "$project_name" 2>/dev/null; then
        echo -e "${YELLOW}📌 Session '$project_name' already exists${NC}"
        tmux attach-session -t "$project_name"
        return 0
    fi
    
    # Create new session
    echo -e "${GREEN}✨ Creating tmux session: $project_name${NC}"
    tmux new-session -d -s "$project_name" -x 250 -y 50
    
    # Create windows for each subdirectory
    IFS=',' read -ra dirs_array <<< "$subdirs"
    local valid_dir_count=0
    
    for dir in "${dirs_array[@]}"; do
        # Trim whitespace
        dir=$(echo "$dir" | xargs)
        local dir_path="$proj_path/$dir"
        
        if [[ -d "$dir_path" ]]; then
            if [[ $valid_dir_count -eq 0 ]]; then
                # Setup first window (base-index 1 in your .tmux.conf)
                tmux send-keys -t "$project_name:1" "cd '$dir_path'" Enter
                tmux send-keys -t "$project_name:1" "clear && echo 'Welcome to $project_name - $dir'" Enter
                tmux rename-window -t "$project_name:1" "$dir"
            else
                # Create new windows for subsequent directories  
                tmux new-window -t "$project_name" -n "$dir"
                tmux send-keys -t "$project_name:$dir" "cd '$dir_path'" Enter
                tmux send-keys -t "$project_name:$dir" "clear && echo 'Welcome to $project_name - $dir'" Enter
            fi
            echo -e "  ${GREEN}✓${NC} Window '$dir' → $dir_path"
            ((valid_dir_count++))
        else
            echo -e "  ${YELLOW}⚠${NC} Directory not found: $dir_path (skipped)"
        fi
    done
    
    # If no valid directories found, at least cd to project root
    if [[ $valid_dir_count -eq 0 ]]; then
        tmux send-keys -t "$project_name:1" "cd '$proj_path'" Enter
        tmux send-keys -t "$project_name:1" "clear && echo 'Welcome to $project_name'" Enter
        tmux rename-window -t "$project_name:1" "main"
    fi
    
    echo ""
    echo -e "${GREEN}✅ Session created successfully!${NC}"
    echo -e "${BLUE}💡 Tmux shortcuts:${NC}"
    echo "   Ctrl+B N/P  - Next/Previous window"
    echo "   Ctrl+B \"  - Split horizontal"
    echo "   Ctrl+B %  - Split vertical"  
    echo "   Ctrl+B D  - Detach session"
    echo "   Ctrl+B C  - Create new window"
    echo ""
    
    # Attach to session
    tmux attach-session -t "$project_name"
}

kill_session() {
    local project_name=$1
    if tmux has-session -t "$project_name" 2>/dev/null; then
        tmux kill-session -t "$project_name"
        echo -e "${GREEN}✅ Session '$project_name' terminated${NC}"
    else
        echo -e "${YELLOW}⚠️  Session '$project_name' not found${NC}"
    fi
}

show_active_sessions() {
    echo -e "${BLUE}🔄 Active Tmux Sessions:${NC}"
    echo ""
    if tmux list-sessions 2>/dev/null; then
        echo ""
    else
        echo "  (none)"
    fi
}

# ============================================================
# MAIN LOGIC
# ============================================================

main() {
    local project_name=${1:-}
    
    # Handle commands
    case "$project_name" in
        -h|--help)
            echo "Usage: workspace [COMMAND|PROJECT_NAME]"
            echo ""
            echo "Commands:"
            echo "  workspace                 - Show interactive menu"
            echo "  workspace <project>       - Open specific project ($(printf '%s, ' "${!PROJECTS[@]}" | sed 's/, $//'))"
            echo "  workspace list            - List all projects"
            echo "  workspace sessions        - Show active sessions"
            echo "  workspace kill <project>  - Kill a session"
            echo "  workspace -h, --help      - Show this help"
            echo ""
            echo "Examples:"
            for project_name in "${!PROJECTS[@]}"; do
                echo "  workspace $project_name"
            done
            echo "  workspace kill rupay"
            return 0
            ;;
        list)
            list_projects
            return 0
            ;;
        sessions)
            show_active_sessions
            return 0
            ;;
        kill)
            if [[ -z "$2" ]]; then
                echo -e "${RED}❌ Please specify project name${NC}"
                echo "   Usage: workspace kill <project>"
                return 1
            fi
            kill_session "$2"
            return 0
            ;;
        "")
            # Show interactive menu
            show_menu
            
            # Create array of project names for selection (sorted for consistency)
            local project_list=($(printf '%s\n' "${!PROJECTS[@]}" | sort))
            
            local max_option=$((${#project_list[@]} + 1))
            read -p "Select option (1-$max_option): " choice
            
            # Validate choice
            if [[ ! "$choice" =~ ^[0-9]+$ ]] || [[ "$choice" -lt 1 ]] || [[ "$choice" -gt "$max_option" ]]; then
                echo -e "${RED}❌ Invalid choice${NC}"
                return 1
            fi
            
            # Check if exit option
            if [[ "$choice" -eq "$max_option" ]]; then
                echo "👋 Goodbye!"
                return 0
            fi
            
            # Get selected project
            project_name="${project_list[$((choice - 1))]}"
            ;;
    esac
    
    # Validate project exists
    local config=$(get_project_config "$project_name")
    if [[ -z "$config" ]]; then
        echo -e "${RED}❌ Project '$project_name' not found${NC}"
        echo ""
        list_projects
        return 1
    fi
    
    # Create and attach to session
    create_tmux_session "$project_name"
}

main "$@"
